# Kopieer dit bestand naar .env.local en vul de echte waarden in.
# .env.local wordt niet gecommit (zie .gitignore).

# Pexels API key voor stock-foto's
# Haal op via: https://www.pexels.com/api/
PEXELS_API_KEY=plak-hier-je-pexels-key

# Optioneel: Google Analytics
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Optioneel: site URL voor SEO (voor productie auto in next.config)
# NEXT_PUBLIC_SITE_URL=https://aivergelijker.nl
